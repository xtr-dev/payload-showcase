# --- Core -------------------------------------------------------------------
# Long random string used to sign auth tokens. `openssl rand -hex 32`
PAYLOAD_SECRET=change-me-to-a-long-random-string
# SQLite file (relative to the project root). To start over, delete it together with its
# write-ahead log (`kiln.db-wal`, `kiln.db-shm`) and run `pnpm seed`.
DATABASE_URL=file:./kiln.db
# How often SQLite syncs writes to disk. FULL (default) syncs every write. NORMAL syncs only at
# checkpoints: much faster on slow disks and still safe from corruption, but a power cut can lose
# the last few writes.
# SQLITE_SYNCHRONOUS=FULL
# Public origin of the site. Leave empty locally; set it when deploying.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Where uploaded media is stored (default: ./media).
# MEDIA_DIR=./media
# Seed an empty database automatically on the first `pnpm dev` (default: true).
# SEED_ON_INIT=true

# --- @xtr-dev/payload-billing ---------------------------------------------------
# Nothing is required: the plugin's local test provider is always on and handles checkout
# (simulated payments, no money moves) unless MOLLIE_API_KEY is set.
#
# Runtime server URL for provider redirects and webhooks. When unset, NEXT_PUBLIC_SERVER_URL is
# used (fixed at build time). Test-provider checkout links are made site-relative either way.
# PAYLOAD_SERVER_URL=https://kiln.example.com
#
# Mollie: when set, checkout goes through Mollie (iDEAL, cards, ...). Webhooks are sent to
# <server URL>/api/payload-billing/mollie/webhook, which must be reachable over HTTPS; without
# them the return page pulls the status from Mollie.
# MOLLIE_API_KEY=test_...
#
# Stripe: when set, the Stripe provider and its webhook (/api/payload-billing/stripe/webhook)
# are registered, so payments created with provider "stripe" are tracked. Checkout itself does
# not use Stripe: it needs a Stripe.js payment form, which the showcase does not ship.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- @xtr-dev/payload-mailing ---------------------------------------------------
# Without SMTP_HOST, mail is captured instead of sent: every message is stored in the
# "Dev outbox" admin collection and shown on /mailbox. Setting SMTP_HOST sends real email
# (and turns /mailbox off). Port 465 uses implicit TLS, other ports STARTTLS.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Kiln & Co. <hello@kiln.test>"
# Mail is delivered by Payload's job queue on a cron in the Next.js server. Set to true to turn
# the cron off (the integration tests do, and drain the queues themselves).
# DISABLE_JOBS_AUTORUN=false

# --- @xtr-dev/payload-notifications ---------------------------------------------
# Web push is optional: without both keys the inbox works and no push endpoints are registered.
# Generate a key pair with `pnpm generate:vapid` and paste the output here. The public key is
# read at runtime by the account page. Push needs HTTPS (or http://localhost).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@kiln.test

# --- @xtr-dev/payload-feature-flags ---------------------------------------------
# (no environment variables needed; flags are managed in the admin panel)

# --- @xtr-dev/payload-automation ------------------------------------------------
# Shared secret for the kiln alert webhook (POST /api/automation/webhooks/kiln-alert).
# Development falls back to a public default; set your own (`openssl rand -hex 32`) anywhere
# else. Only its hash is stored, and it is brought up to date on every start: after changing the
# secret, restart the server. A production server without it uses a new random secret on every
# start, so nobody can call the webhook.
# AUTOMATION_WEBHOOK_SECRET=
# Where the kiln alert workflow's HTTP step posts. Defaults to this site's mock pager.
# PUBLIC_KILN_PAGER_URL=http://localhost:3000/api/studio/kiln-pager
