{
  "name": "payload-showcase",
  "version": "0.0.0",
  "description": "Kiln & Co. — a demo site showcasing the xtr-dev Payload CMS plugins",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/run.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "e2e:server": "bash scripts/e2e-server.sh"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.94.2",
    "@payloadcms/next": "3.94.2",
    "@payloadcms/richtext-lexical": "3.94.2",
    "@payloadcms/ui": "3.94.2",
    "@xtr-dev/payload-feature-flags": "^0.1.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.4.6",
    "payload": "3.94.2",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.33",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1",
    "pnpm": ">=11"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/xtr-dev/payload-showcase"
  },
  "packageManager": "pnpm@11.9.0"
}
